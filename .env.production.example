# What the server needs in production. Copy to .env.production (gitignored)
# and fill in, then put each line in the host's environment variables — or run
# the image with `docker run --env-file .env.production …`. The server refuses
# to start without the required ones (see the checks at the top of
# src/server.js).

NODE_ENV=production

# Required. Long random values of their own — never the dev ones from .env.
# At least 32 characters each, and different from each other. Make one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing JWT_SECRET later signs everyone out; changing QR_SECRET changes
# every member's check-in QR code.
JWT_SECRET=
QR_SECRET=

# Required. The hosted Postgres, with automatic backups turned on. On Neon,
# use the pooled connection string (the host with "-pooler" in it) — the
# app's connections go through Neon's pooler, which is quicker to connect.
DATABASE_URL=
# Optional. On Neon, the direct connection string (the same host without
# "-pooler"): `prisma migrate deploy` uses it, since migrations need a direct
# connection. Left out, migrations use DATABASE_URL.
DIRECT_URL=

# Required. The site's address, no trailing slash — the links in verification,
# reset, reminder and offer emails are built on it.
APP_URL=https://

# Required: one way to send email.
#   Resend (recommended): RESEND_API_KEY, and EMAIL_FROM on a domain verified
#   with Resend.
#   Gmail: GMAIL_USER plus either the Gmail API settings (GMAIL_CLIENT_ID,
#   GMAIL_CLIENT_SECRET, and GMAIL_REFRESH_TOKEN from `npm run gmail-token`),
#   which work on any host, or GMAIL_APP_PASSWORD (an app password, not the
#   account's), which needs a host that allows outgoing mail ports. Render's
#   free plan doesn't, so use the API settings there.
#   With both Resend and Gmail set, the officer dashboard's "Email all" goes
#   through Gmail (about 500 recipients a day, free) and everything else
#   through Resend.
RESEND_API_KEY=
GMAIL_USER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_APP_PASSWORD=
EMAIL_FROM="Elemental Beauty <hello@your-domain>"
# optional: where replies to the club's emails go
EMAIL_REPLY_TO=

# Optional. The port to listen on (5003 by default; most hosts set this), and
# the club's clock (America/Indiana/Indianapolis by default).
# PORT=
# CLUB_TZ=
