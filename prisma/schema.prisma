// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

// Ranked in this order (see requireRole.js). J-board has everything an
// officer has; only an admin can give it (or any staff role) to anyone.
// `advisor` is the club's faculty advisor: they see everything an admin sees
// and change nothing, bar emailing everyone (src/middleware/advisor.js).
enum MemberRole {
  member
  // A member who has paid this school year's dues. Same footing as a member
  // in everything they can do; it's switched on and off by the dues
  // themselves (syncVipRoles in src/dues.js), and picking it on /students
  // records the payment.
  vip
  officer
  jboard
  treasurer
  admin
  advisor

  @@map("member_role")
}

// `offered` is someone moved off the waitlist into a spot that's theirs if
// they accept — it holds the seat, and accepting (the emailed link, or the
// lab's page) makes it `rsvped`. See src/offers.js.
enum AttendanceStatus {
  rsvped
  attended
  absent
  waitlisted
  offered

  @@map("attendance_status")
}

enum EventType {
  official
  social

  @@map("event_type")
}

// Who an event is for. The calendar colours a day by this and the member
// calendar drops `officers` and `board` entirely, so it's the field that
// decides whether a row is ever sent to a member at all — not just how it's
// drawn. `board` is "EB board": j-board and every staff role above a member.
// `jboard` is j-board's own: officers don't see it, and j-board in turn
// doesn't see `officers` (see eventRoutes.js).
enum EventTrack {
  members
  officers
  open
  online
  board
  jboard

  @@map("event_track")
}

// Which j-board team a j-board event is for (events.team). `social_media`
// rather than 'social media' for the same reason as GrantStatus's
// under_review; the pages write the space back in.
enum EventTeam {
  communication
  secretary
  treasury
  formula
  social_media

  @@map("event_team")
}

enum TransactionType {
  income
  expense

  @@map("transaction_type")
}

// A receipt an officer hands in walks pending -> approved -> reimbursed, and
// `approved` is not the end of it: agreeing the club owes the money and actually
// handing it back are two different days, and only the second one is a line of
// spending. That's why `reimbursed` exists rather than the ledger row being
// written on approval.
enum ReimbursementStatus {
  pending
  approved
  reimbursed
  denied

  @@map("reimbursement_status")
}

// How someone who owes dues got into one lab or members-only event without
// paying the year's dues: the non-member price for that one ('fee'), or let in
// free that once ('waive'). Answered at the door's dues popup, or ahead of
// time from the $ on the check-in page — either way it's kept on their row,
// so checking them in doesn't ask again (see src/dues.js). Paying the year's
// dues isn't one of these: that's a DuesPayment, and settles every lab.
enum DoorPayment {
  fee
  waive

  @@map("door_payment")
}

// How far along a grant application is. Ordered by progress rather than
// alphabetically — the ledger sorts on this order, so it has to be the
// declaration order too.
//
// `under_review` rather than 'under review': Prisma's client speaks the
// identifier, not the mapped database value, so a @map here would put a space
// in the column's type and change nothing anyone actually sees. The page turns
// the underscore back into a space when it prints it.
enum GrantStatus {
  drafting
  under_review
  awarded
  denied

  @@map("grant_status")
}

// ---------- Users / Members ----------

// The account. Everything here belongs to somebody the moment they sign up,
// before there's a membership behind it — which is what decides what lives on
// this row rather than on `members`:
//
//   firstName / lastName  the roster, the leaderboard, the Elementist pass and
//     every receipt's "who" are all a person's name, and /students collects both
//     when an officer adds a student. Nothing derives them from the username.
//     Empty rather than nullable: signing yourself up asks for a username and a
//     password and nothing else, so an account can exist before anyone has said
//     what to call it — and every page that draws a name already copes with a
//     blank one (initials fall back to '?'), where a null would throw. /account
//     and /students both refuse to *save* an empty one.
//   instagram             the sign-up form asks for it (optional) at the moment
//     an account is created, which is before email verification and the waiver
//     have made a member row exist.
//   discord               their discord username, beside instagram on /account's
//     socials card — optional, and anyone with an account can set it.
//   profilePicture        /account shows the photo picker to role 'user' too —
//     somebody with an account and no membership can still set a picture.
model User {
  userId         Int      @id @default(autoincrement()) @map("user_id")
  username       String   @unique
  passwordHash   String   @map("password_hash")
  email          String   @unique
  firstName      String   @default("") @map("first_name")
  lastName       String   @default("") @map("last_name")
  instagram      String?
  discord        String?
  profilePicture String?  @map("profile_picture")
  emailVerified  Boolean  @default(false) @map("email_verified")
  waiverSigned   Boolean  @default(false) @map("waiver_signed")
  // The signature itself: the name typed at the bottom of the waiver and when.
  // Null for accounts from before the waiver was signed on the site, and for
  // students an officer added (they were vouched for in person).
  waiverName     String?   @map("waiver_name")
  waiverSignedAt DateTime? @map("waiver_signed_at") @db.Timestamptz()
  // Whether the officer dashboard's club-wide "Email All" reaches them — set
  // from /account. null = never chosen, which follows the role: members are
  // in, staff are out until they opt in (see src/emailPrefs.js). true/false =
  // their choice. Account mail, and everything about a lab or event they've
  // signed up for, goes regardless.
  emailClub      Boolean?  @map("email_club")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  member        Member?
  announcements Announcement[]
  eventsCreated Event[]
  emailsSent    EmailSend[]

  // the roster sorts and searches on names as often as on the username
  @@index([lastName, firstName])
  @@map("users")
}

// The membership. What's here is what only means something once someone has
// actually joined: their rank, their points, and the day they joined.
//
// The five numbers on /account's counter — points, labs done, labs rsvp'd,
// events done, events rsvp'd — are four counts over member_lab / member_event
// plus this row's points, so only the points are stored.
model Member {
  userId     Int        @id @map("user_id")
  role       MemberRole @default(member)
  points     Int        @default(0)
  dateJoined DateTime   @default(dbgenerated("CURRENT_DATE")) @map("date_joined") @db.Date
  // The j-board teams they're on, set by an admin from /students — only a
  // j-board member has any, and can have several. They see the j-board events
  // of every team they're on and the ones for all of j-board, not another
  // team's (see eventRoutes.js).
  jboardTeams EventTeam[] @default([]) @map("jboard_teams")
  // The one-time awards they've had ('instagram_follow', 'discord_join' —
  // ONE_TIME_ACTIONS in src/points.js): each is given once, and the same
  // button on /students takes it back.
  awardsClaimed String[] @default([]) @map("awards_claimed")

  user           User            @relation(fields: [userId], references: [userId], onDelete: Cascade)
  labs           MemberLab[]
  events         MemberEvent[]
  reimbursements Reimbursement[]
  dues           DuesPayment[]
  payments       MemberPayment[]

  @@map("members")
}

// ---------- Announcements ----------

// What the officer dashboard's "make announcement" box posts and the member
// dashboard's banner shows. The author survives being demoted but not being
// deleted along with their account — an announcement with nobody behind it is
// still the club's announcement, so the reference goes null rather than taking
// the row with it.
model Announcement {
  announcementId Int      @id @default(autoincrement()) @map("announcement_id")
  body           String
  authorId       Int?     @map("author_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  author User? @relation(fields: [authorId], references: [userId], onDelete: SetNull)

  @@index([createdAt])
  @@map("announcements")
}

// ---------- Labs ----------

model Lab {
  labId        Int      @id @default(autoincrement()) @map("lab_id")
  title        String
  // Only a draft can be without one — publishing needs a date (see
  // PUT /api/labs/:id), and members only ever see published labs.
  date         DateTime? @db.Date
  // 'HH:MM', same as events.start_time — the member view uses it to decide
  // when the lab has started and check-in (the QR) takes over from the RSVP.
  // Null means the lab counts as started from the beginning of its day.
  startTime    String?  @map("start_time") @db.VarChar(5)
  // When it finishes, 'HH:MM' — optional, only with a start time, and after
  // it. Pages print the two as a range ('6:00-7:00pm').
  endTime      String?  @map("end_time") @db.VarChar(5)
  // The room, as printed on the header line ('WTHR 200').
  location     String?
  // null = unlimited seats, same as events.capacity — the edit page's
  // "seats available" is optional
  capacity     Int?
  // What someone who hasn't paid the year's dues is charged at the door for
  // it — shown on the cards they see, and taken as income under 'fees' (see
  // src/dues.js). Set on the edit page; 0 = nothing extra.
  nonmemberPrice Decimal @default(0) @map("nonmember_price") @db.Decimal(10, 2)
  description  String?
  image        String?
  ingredients  String?
  equipment    String?
  safetyNote   String?  @map("safety_note")
  instructions String?
  // The lesson tab's PDF, uploaded by an officer. Kept in the row rather than
  // on disk so a lab is one thing to back up and move, same as its image. The
  // bytes are left out of every query by default (see prismaClient.js) and only
  // read by the endpoint that serves the file; the name is what the viewer's
  // download button saves it as, and doubles as "is there a lesson at all".
  lessonPdf     Bytes?  @map("lesson_pdf")
  lessonPdfName String? @map("lesson_pdf_name")
  // The prelab handout, uploaded on the check-in page and attached to the
  // confirmation emails (src/offers.js). Kept like the lesson: in the row,
  // left out of every query by default.
  prelabPdf     Bytes?  @map("prelab_pdf")
  prelabPdfName String? @map("prelab_pdf_name")
  // when the check-in page's "confirmation" last went out — after that,
  // anyone who takes a spot off the waitlist is sent the prelab too
  confirmSentAt DateTime? @map("confirm_sent_at") @db.Timestamptz()
  // when its payment due date (a week before, 11:59 PM) was enforced:
  // everyone still owing with nothing sent in was moved to the waitlist, once
  // (src/payments.js). Set for any lab already past it when this was added.
  paymentsDueSweptAt DateTime? @map("payments_due_swept_at") @db.Timestamptz()
  // when the day-before reminder went out to everyone signed up (see
  // src/reminders.js). Cleared when the date or time moves, so a rescheduled
  // lab is reminded about again.
  reminderSentAt DateTime? @map("reminder_sent_at") @db.Timestamptz()
  // A lab saved with "save draft" and never published is hidden from
  // members entirely. Existing labs were all live, hence the default.
  published     Boolean @default(true)
  // "save draft" on a lab that's already live can't touch the live row —
  // members are signed up to it — so the edits wait here, in the same shape
  // PUT /labs/:id takes, until they're published or discarded.
  draft         Json?
  // The same for the quiz: its editor's unpublished questions, as
  // [{ question, options: [{ answerText, isCorrect }] }]. Members only ever
  // see the published lab_quiz_questions.
  quizDraft     Json?   @map("quiz_draft")
  // Whether j-board may edit it (details, lesson, quiz — not delete it).
  // Switched from the lab's dots menu by an officer, the treasurer or an
  // admin; off by default (see labRoutes.js).
  jboardCanEdit Boolean @default(false) @map("jboard_can_edit")
  // Whether it's taking sign-ups. Off, members still see it but get no rsvp
  // button and new RSVPs are refused; anyone already on it can still cancel
  // or take an offered spot. Switched from the dots menu, like the one above.
  acceptingRsvps Boolean @default(true) @map("accepting_rsvps")
  // Check-in opened early from the check-in page ("start check-in"): people
  // signed up get their QR code on the lab's page before its start time. The
  // door opens on its own at the start time regardless (see roster.js).
  checkinOpen   Boolean @default(false) @map("checkin_open")

  lessons       LabLesson[]
  quizQuestions LabQuizQuestion[]
  members       MemberLab[]
  payments      MemberPayment[]
  emailSends    EmailSend[]

  @@map("labs")
}

model LabLesson {
  lessonId    Int     @id @default(autoincrement()) @map("lesson_id")
  labId       Int     @map("lab_id")
  title       String
  explanation String?

  lab Lab @relation(fields: [labId], references: [labId], onDelete: Cascade)

  @@index([labId])
  @@map("lab_lessons")
}

model LabQuizQuestion {
  questionId Int    @id @default(autoincrement()) @map("question_id")
  labId      Int    @map("lab_id")
  question   String

  lab     Lab                @relation(fields: [labId], references: [labId], onDelete: Cascade)
  options QuizAnswerOption[]

  @@index([labId])
  @@map("lab_quiz_questions")
}

model QuizAnswerOption {
  optionId   Int     @id @default(autoincrement()) @map("option_id")
  questionId Int     @map("question_id")
  answerText String  @map("answer_text")
  isCorrect  Boolean @default(false) @map("is_correct")

  question LabQuizQuestion @relation(fields: [questionId], references: [questionId], onDelete: Cascade)

  @@index([questionId])
  @@map("quiz_answer_options")
}

// ---------- Events ----------

// The kinds of thing that turn up on the calendar — GBM, Workshop, Social,
// Pop-Up and the rest. A table rather than an enum because the officer calendar
// lets officers add and remove tags themselves, and an enum can't be edited
// from the app.
//
// 'Lab' is deliberately not one of these: labs carry sign-ups, a quiz and
// check-in, so they're their own model and are scheduled from /labs.
model EventCategory {
  categoryId Int    @id @default(autoincrement()) @map("category_id")
  name       String @unique

  events Event[]

  @@map("event_categories")
}

model Event {
  eventId     Int        @id @default(autoincrement()) @map("event_id")
  title       String
  type        EventType  @default(social)
  // Who it's for. The member calendar never sees `officers` rows — that filter
  // belongs on the API, not just on the page.
  track       EventTrack @default(members)
  categoryId  Int?       @map("category_id")
  description String?
  date        DateTime   @db.Date
  // Start time as 'HH:MM', which is what <input type="time"> hands back and
  // what the calendar prints. Null for something with no clock time on it —
  // a deadline, say. A CHECK constraint holds the format (see migrations).
  startTime   String?    @map("start_time") @db.VarChar(5)
  // When it finishes, 'HH:MM' — optional, only with a start time, and after
  // it. Pages print the two as a range ('6:00-7:00pm').
  endTime     String?    @map("end_time") @db.VarChar(5)
  // The room, as on a lab ('WTHR 200'). Optional — plenty of events are
  // online or somewhere that isn't a room.
  location    String?
  image       String?
  capacity    Int? // null = unlimited seats
  // The same door charge a lab has, for someone who hasn't paid dues. Only
  // a members-only event asks (asksDues in src/dues.js), so anything else
  // keeps 0.
  nonmemberPrice Decimal @default(0) @map("nonmember_price") @db.Decimal(10, 2)
  // The j-board team it's for — only on a j-board event, where the form asks
  // for this in place of a seat cap (so a j-board event's capacity is null).
  // Null = the whole of j-board.
  team        EventTeam?
  // The "hide from events" switch: kept off both /events pages, whoever it's
  // for and whatever its tag — it still shows on the calendar. Meetings and
  // the board's tracks are kept off regardless (frontend/lib/calendar.js).
  hideFromEvents Boolean @default(false) @map("hide_from_events")
  // Titled links the event's page lists under its photo — a guest speaker's
  // LinkedIn, a sign-up sheet: [{ title, url }, ...]. Null or [] = none.
  links          Json?
  // Where it's held, as a link — a Zoom or Meet address. The calendar gives
  // it a "join" button. Only kept on an online, officers, EB board or j-board
  // event (MEETING_TRACKS in eventRoutes.js).
  meetingUrl     String?  @map("meeting_url")
  // Check-in opened early from the check-in page, as a lab's checkinOpen.
  checkinOpen    Boolean  @default(false) @map("checkin_open")
  // Who added it. Decides one thing: a j-board event added by an officer,
  // treasurer or admin is read-only to j-board (see eventRoutes.js). Null for
  // events from before this was kept, and for a creator since deleted.
  createdById Int? @map("created_by")
  // when the check-in page's "confirmation" last went out (src/offers.js)
  confirmSentAt DateTime? @map("confirm_sent_at") @db.Timestamptz()
  // when its payment due date was enforced, as a lab's (src/payments.js)
  paymentsDueSweptAt DateTime? @map("payments_due_swept_at") @db.Timestamptz()
  // the day-before reminder, same as a lab's (src/reminders.js)
  reminderSentAt DateTime? @map("reminder_sent_at") @db.Timestamptz()

  // Deleting a tag off the calendar's legend leaves the events that used it
  // standing — they just stop being filed under anything.
  category  EventCategory? @relation(fields: [categoryId], references: [categoryId], onDelete: SetNull)
  createdBy User?          @relation(fields: [createdById], references: [userId], onDelete: SetNull)
  members    MemberEvent[]
  payments   MemberPayment[]
  emailSends EmailSend[]

  @@index([date])
  @@index([categoryId])
  @@map("events")
}

// ---------- Junctions ----------

model MemberLab {
  memberId         Int              @map("member_id")
  labId            Int              @map("lab_id")
  attendanceStatus AttendanceStatus @default(rsvped) @map("attendance_status")
  quizPassed       Boolean?         @map("quiz_passed")
  waitlistedAt     DateTime?        @map("waitlisted_at") @db.Timestamptz()
  // when an officer last emailed an offer (null = not yet) — an offer left
  // unanswered for 48 hours lapses, see src/offers.js
  offerSentAt      DateTime?        @map("offer_sent_at") @db.Timestamptz()
  // "confirmation": when they were asked to confirm their spot, the deadline
  // the officer set for it, and when they did — asked and not confirmed by
  // the deadline lapses (src/offers.js)
  confirmSentAt    DateTime?        @map("confirm_sent_at") @db.Timestamptz()
  confirmBy        DateTime?        @map("confirm_by") @db.Timestamptz()
  confirmedAt      DateTime?        @map("confirmed_at") @db.Timestamptz()
  // owing for it after its payment due date had passed (signed up late, or
  // an entry taken back): the 48 hours they have to pay by, and when they
  // were last reminded — offered a spot and owing, too (src/payments.js)
  payBy            DateTime?        @map("pay_by") @db.Timestamptz()
  payRemindedAt    DateTime?        @map("pay_reminded_at") @db.Timestamptz()
  // the entry paid or waived for this one, when they owe dues (DoorPayment),
  // and the income row a paid one wrote — what undoing it takes back out
  doorPayment       DoorPayment?     @map("door_payment")
  doorTransactionId Int?             @unique @map("door_transaction_id")

  member          Member       @relation(fields: [memberId], references: [userId], onDelete: Cascade)
  lab             Lab          @relation(fields: [labId], references: [labId], onDelete: Cascade)
  doorTransaction Transaction? @relation(fields: [doorTransactionId], references: [transactionId], onDelete: SetNull)

  @@id([memberId, labId])
  @@index([labId])
  @@map("member_lab")
}

model MemberEvent {
  memberId         Int              @map("member_id")
  eventId          Int              @map("event_id")
  attendanceStatus AttendanceStatus @default(rsvped) @map("attendance_status")
  waitlistedAt     DateTime?        @map("waitlisted_at") @db.Timestamptz()
  offerSentAt      DateTime?        @map("offer_sent_at") @db.Timestamptz()
  // "confirmation": when they were asked to confirm their spot, the deadline
  // the officer set for it, and when they did — asked and not confirmed by
  // the deadline lapses (src/offers.js)
  confirmSentAt    DateTime?        @map("confirm_sent_at") @db.Timestamptz()
  confirmBy        DateTime?        @map("confirm_by") @db.Timestamptz()
  confirmedAt      DateTime?        @map("confirmed_at") @db.Timestamptz()
  // owing for it after its payment due date had passed (signed up late, or
  // an entry taken back): the 48 hours they have to pay by, and when they
  // were last reminded — offered a spot and owing, too (src/payments.js)
  payBy            DateTime?        @map("pay_by") @db.Timestamptz()
  payRemindedAt    DateTime?        @map("pay_reminded_at") @db.Timestamptz()
  // the entry paid or waived for this one, when they owe dues (DoorPayment),
  // and the income row a paid one wrote — what undoing it takes back out
  doorPayment       DoorPayment?     @map("door_payment")
  doorTransactionId Int?             @unique @map("door_transaction_id")

  member          Member       @relation(fields: [memberId], references: [userId], onDelete: Cascade)
  event           Event        @relation(fields: [eventId], references: [eventId], onDelete: Cascade)
  doorTransaction Transaction? @relation(fields: [doorTransactionId], references: [transactionId], onDelete: SetNull)

  @@id([memberId, eventId])
  @@index([eventId])
  @@map("member_event")
}

// ---------- Finances ----------

// Where money comes from and where it goes, as the two analytics pages slice
// it: the income ones are the income summary's donut, the expense ones the
// expense summary's — and the expense ones are also what a receipt gets filed
// under, so a settled request lands in one of them.
//
// A table rather than an enum because the treasurer adds and removes them
// from /analytics. `key` is what a ledger row or a receipt stores ('dues'),
// and it never changes once made; `label` is what the page prints. Four can't
// be removed because the app files money under them itself — grants, dues,
// fees and sponsors (LOCKED in src/financeCategories.js) — and none can be
// while a row or a receipt is filed under it (ON DELETE RESTRICT).
//
// `position` is the slice order: the seeded ones in the order the donuts have
// always drawn them, and each one added after them at the end. `description`
// is the optional line the categories card prints under it.
model FinanceCategory {
  key         String          @id
  label       String
  type        TransactionType
  color       String
  description String?
  position    Int             @default(autoincrement())

  transactions   Transaction[]
  reimbursements Reimbursement[]

  @@map("finance_categories")
}

// A grant application, tracked from before it's sent. `amountRequested` is what
// was asked for and `status` is what says whether the club ever saw it — only
// an awarded one is money. Awarding one writes its income row (category
// 'grants', linked by grantId), by trigger — see the
// fees_links_payouts_grant_income migration.
//
// That's what makes `dateGranted` nullable: a drafting application hasn't been
// granted anything yet, and the tracker still has to be able to hold it. It's
// filled in with the day it's awarded, if nobody set one.
model Grant {
  grantId         Int         @id @default(autoincrement()) @map("grant_id")
  name            String
  org             String
  amountRequested Decimal     @map("amount_requested") @db.Decimal(10, 2)
  // What was actually granted, which is often not what was asked for. Only
  // an awarded grant has one; the tracker's "remaining" is counted from it.
  amountAwarded   Decimal?    @map("amount_awarded") @db.Decimal(10, 2)
  status          GrantStatus @default(drafting)
  // the application deadline, which is what the tracker counts down to
  deadline        DateTime    @db.Date
  dateGranted     DateTime?   @map("date_granted") @db.Date
  expirationDate  DateTime?   @map("expiration_date") @db.Date

  transactions Transaction[]

  @@index([status])
  @@map("grants")
}

// What the year was budgeted at, edited in place on the two summary cards. One
// row per school year — '2025–26' — because the treasurer sets a fresh pair
// every august and last year's figures stay on last year's view.
model YearTarget {
  schoolYear    String  @id @map("school_year")
  incomeGoal    Decimal @map("income_goal") @db.Decimal(10, 2)
  expenseBudget Decimal @map("expense_budget") @db.Decimal(10, 2)
  // What a member owes in dues that year — the dues card's default when the
  // treasurer marks someone paid. 0 = not set yet.
  duesAmount    Decimal @default(0) @map("dues_amount") @db.Decimal(10, 2)
  // (The non-member price used to be here too, one for the whole year. It's
  // on each lab and event now — Lab.nonmemberPrice, Event.nonmemberPrice.)

  @@map("year_targets")
}

// A receipt an officer handed in, which is the same row the treasurer settles.
// The receipts card and the transaction history on /analytics are two views of
// this one table.
//
// `title` and `explanation` are two different things and the form asks for both:
// the title is what the row is called everywhere it's listed, the explanation is
// what it was bought for. `date` is the day of the purchase, not the day it was
// filed — settling it writes the expense against that day, so the spending lands
// in the month the club incurred it.
//
// A denial has to say why, and that reason is what the officer answers when they
// fix the request and send it back. One that's been round once keeps the old
// objection in `previousDenial`, so the treasurer can see it's a second attempt
// and at what.
model Reimbursement {
  reimbursementId   Int                 @id @default(autoincrement()) @map("reimbursement_id")
  memberId          Int?                @map("member_id")
  title             String
  explanation       String
  amountRequested   Decimal             @map("amount_requested") @db.Decimal(10, 2)
  category          String
  status            ReimbursementStatus @default(pending)
  denialExplanation String?             @map("denial_explanation")
  previousDenial    String?             @map("previous_denial")
  receipt           String?
  date              DateTime            @default(dbgenerated("CURRENT_DATE")) @db.Date
  // Where to send the money back: the platform ('zelle', 'venmo', 'cash' —
  // see PAYOUT_METHODS in reimbursementRoutes.js) and the phone number, email
  // or username on it. Null on requests filed before the form asked.
  payoutMethod      String?             @map("payout_method")
  payoutHandle      String?             @map("payout_handle")

  member       Member?         @relation(fields: [memberId], references: [userId], onDelete: SetNull)
  categoryInfo FinanceCategory @relation(fields: [category], references: [key], onDelete: Restrict)
  transaction  Transaction?

  @@index([memberId])
  @@index([status])
  @@map("reimbursements")
}

model Transaction {
  transactionId   Int             @id @default(autoincrement()) @map("transaction_id")
  type            TransactionType
  source          String
  amount          Decimal         @db.Decimal(10, 2)
  category        String
  date            DateTime        @default(dbgenerated("CURRENT_DATE")) @db.Date
  grantId         Int?            @map("grant_id")
  reimbursementId Int?            @unique @map("reimbursement_id")

  grant         Grant?          @relation(fields: [grantId], references: [grantId], onDelete: Restrict)
  reimbursement Reimbursement?  @relation(fields: [reimbursementId], references: [reimbursementId], onDelete: Restrict)
  categoryInfo  FinanceCategory @relation(fields: [category], references: [key], onDelete: Restrict)
  dues          DuesPayment?
  doorLab       MemberLab?
  doorEvent     MemberEvent?
  payment       MemberPayment?

  @@index([date])
  @@index([grantId])
  @@map("transactions")
}

// ---- Dues ----

// One member's dues for one school year ('2025–26'), marked by the treasurer.
// Paying writes an income row filed under 'dues' — the money is in the ledger
// like any other — and `transactionId` is that row. A waived year is a payment
// of 0 with no ledger row behind it.
//
// Deleting the ledger row takes the payment with it (the member reads as
// unpaid again); deleting the member takes the payment but leaves the ledger
// row, because the money did come in.
model DuesPayment {
  duesId        Int      @id @default(autoincrement()) @map("dues_id")
  memberId      Int      @map("member_id")
  schoolYear    String   @map("school_year")
  amount        Decimal  @db.Decimal(10, 2)
  paidOn        DateTime @default(dbgenerated("CURRENT_DATE")) @map("paid_on") @db.Date
  transactionId Int?     @unique @map("transaction_id")

  member      Member       @relation(fields: [memberId], references: [userId], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [transactionId], onDelete: Cascade)

  @@unique([memberId, schoolYear])
  @@index([schoolYear])
  @@map("dues_payments")
}

// ---- Payments members send in ----

// A way to pay the club, kept on /analytics' "accepted payments" card by the
// treasurer or admin: what members pick from the payment dropdown ('Venmo'),
// its QR code (a data URL, like a receipt photo) and a line printed under it.
model PaymentMethod {
  methodId    Int      @id @default(autoincrement()) @map("method_id")
  title       String
  image       String?
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  payments MemberPayment[]

  @@map("payment_methods")
}

// What a payment a member sent in was for: the year's dues (they turn VIP) or
// one lab's or members-only event's non-member price.
enum PaymentKind {
  dues
  fee

  @@map("payment_kind")
}

// pending -> approved (the money's in the ledger), rejected ("send back": with
// a reason, they fix it and send it again — within 48 hours, when it's for a
// lab or event, or they're moved to its waitlist) or declined ("reject": it's
// not accepted, and they're moved to the waitlist of the lab or event it was
// sent from; a sent-back one left unfixed for 48 hours ends here too).
// `reversed` is an approved one taken back from the check-in page's grey $ —
// they're unpaid again and can send another. See src/payments.js.
enum PaymentStatus {
  pending
  approved
  rejected
  declined
  reversed

  @@map("payment_status")
}

// A payment a member made on their own — by Venmo, Zelle, whatever's on the
// accepted payments card — and told the club about from a lab's or event's
// page, or /vip, with the transaction id the app gave them. The treasurer or
// admin checks it and approves it (which writes the income row, the same as
// the door's "paid entry" / "paid dues") or sends it back with a reason. The
// same shape as a receipt an officer hands in, the other way round.
//
// `labId` / `eventId` is where it was sent from — a fee is always for that
// one; dues sent from /vip have neither. `schoolYear` is the year the dues
// are for (the lab's year, or this one). `amount` and `methodTitle` are kept
// as they were when it was sent, so changing the price or removing the method
// later doesn't rewrite it. `transactionId` is the income row approving it
// wrote.
model MemberPayment {
  paymentId       Int           @id @default(autoincrement()) @map("payment_id")
  memberId        Int           @map("member_id")
  kind            PaymentKind
  labId           Int?          @map("lab_id")
  eventId         Int?          @map("event_id")
  schoolYear      String        @map("school_year")
  amount          Decimal       @db.Decimal(10, 2)
  methodId        Int?          @map("method_id")
  methodTitle     String        @map("method_title")
  reference       String
  screenshot      String?
  status          PaymentStatus @default(pending)
  rejectionReason String?       @map("rejection_reason")
  submittedAt     DateTime      @default(now()) @map("submitted_at") @db.Timestamptz()
  reviewedAt      DateTime?     @map("reviewed_at") @db.Timestamptz()
  transactionId   Int?          @unique @map("transaction_id")

  member      Member         @relation(fields: [memberId], references: [userId], onDelete: Cascade)
  lab         Lab?           @relation(fields: [labId], references: [labId], onDelete: SetNull)
  event       Event?         @relation(fields: [eventId], references: [eventId], onDelete: SetNull)
  method      PaymentMethod? @relation(fields: [methodId], references: [methodId], onDelete: SetNull)
  transaction Transaction?   @relation(fields: [transactionId], references: [transactionId], onDelete: SetNull)

  @@index([memberId])
  @@index([labId])
  @@index([eventId])
  @@index([status])
  @@map("member_payments")
}

// ---- Activity log ----

// Who did what to whom, for staff: role changes, points given and taken back,
// students added and removed, dues marked. Written by src/activity.js.
//
// Names are copied in when the row is written, and there are no foreign keys:
// the log is the record of a removed member, so it can't be deleted along with
// them. `points` is the change to the target's points, when there was one —
// which is also what a member's own points history reads its manual awards
// from.
model ActivityLog {
  activityId Int      @id @default(autoincrement()) @map("activity_id")
  actorId    Int?     @map("actor_id")
  actorName  String   @map("actor_name")
  action     String
  targetId   Int?     @map("target_id")
  targetName String?  @map("target_name")
  points     Int?
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([createdAt])
  @@index([targetId])
  @@map("activity_log")
}

// ---------- Emails sent by hand ----------

// The emails officers send from a button, so the popup that sends one can say
// when it last went out:
//
//   email_all        "email all" — on a lab's or event's check-in page (labId
//                    / eventId), or the officer dashboard's club-wide one
//                    (neither)
//   unpaid_reminder  the check-in page's "email unpaid"
//   confirmation     the check-in page's "confirmation", with the deadline it
//                    set (`deadline`) — sent again, that's the new deadline
enum EmailSendKind {
  email_all
  unpaid_reminder
  confirmation

  @@map("email_send_kind")
}

// One row per send — `sent` is how many it reached, `sentById` who pressed
// the button (null once they're gone).
model EmailSend {
  emailSendId Int           @id @default(autoincrement()) @map("email_send_id")
  kind        EmailSendKind
  labId       Int?          @map("lab_id")
  eventId     Int?          @map("event_id")
  sentAt      DateTime      @default(now()) @map("sent_at") @db.Timestamptz()
  deadline    DateTime?     @db.Timestamptz()
  sent        Int           @default(0)
  sentById    Int?          @map("sent_by")

  lab    Lab?   @relation(fields: [labId], references: [labId], onDelete: Cascade)
  event  Event? @relation(fields: [eventId], references: [eventId], onDelete: Cascade)
  sentBy User?  @relation(fields: [sentById], references: [userId], onDelete: SetNull)

  @@index([kind, labId])
  @@index([kind, eventId])
  @@map("email_sends")
}
